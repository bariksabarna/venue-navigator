# Firebase project configuration — these are IDENTIFIERS, not secrets.
# They are safe to ship in client code (App Check enforces abuse protection).
# Copy this file to .env and fill in your real values.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890

# reCAPTCHA v3 site key for Firebase App Check — also a public identifier.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key

# NOTE: The Gemini API key NEVER appears here — it stays inside Firebase AI Logic
# server-side proxy. If you need a local fallback for development, use the
# Firebase emulator suite (firebase emulators:start).
